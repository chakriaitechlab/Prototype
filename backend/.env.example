PORT=8000
NODE_ENV=development

# Allowed frontend origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Admin panel seed credentials (first admin user, created by `prisma db seed`)
ADMIN_EMAIL=
ADMIN_PASSWORD=

DATABASE_URL=
REDIS_URL=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Agent Gmail connector (redirect URI must be added in Google Cloud Console)
GMAIL_REDIRECT_URI=http://localhost:3000/api/agent/connectors/gmail/callback
# 32-byte key for encrypting connector tokens: openssl rand -base64 32 (never change once set)
CONNECTOR_ENCRYPTION_KEY=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Resend Email Service
RESEND_API_KEY=
RESEND_FROM=

# Support inbox (receives /support contact form inquiries)
SUPPORT_EMAIL=support@chakriai.com

# WhatsApp OTP Gateway
WA_GATEWAY_URL=https://wapi.ars2k03.online
WA_GATEWAY_KEY=

# SSLCommerz payment gateway (store credentials from the merchant panel; IS_LIVE=false uses the sandbox)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Public API URL (SSLCommerz callbacks) and frontend URL (redirect after payment)
API_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Shared key the govt-jobs worker sends as the X-Worker-Key header (POST /api/govt-jobs/v1/:id/details); generate with: openssl rand -base64 32
GOVT_JOBS_WORKER_KEY=

# Cloudflare R2 Storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Ollama AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Gemini Live API key for AI interview voice (text-to-speech and live speech-to-text)
GEMINI_API_KEY=

# Public signup: true (default) or false to close registration and show the waitlist
ENABLED_SIGNUP=true

# Signup limit per device
DEVICE_SIGNUP_MAX=30
DEVICE_SIGNUP_WINDOW_DAYS=30

# Playwright browser location: set to 0 on Render so Chromium is installed inside node_modules; leave unset locally
PLAYWRIGHT_BROWSERS_PATH=
